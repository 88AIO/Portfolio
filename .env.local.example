# Copy this file to .env.local and fill in your keys.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; keep secret

# --- Market data ---
# Provider behind lib/marketdata. Default "yahoo" (free, US-first) — no key needed.
# Set to "eodhd" to use the paid EODHD feed (then fill EODHD_API_TOKEN below).
MARKET_DATA_PROVIDER=yahoo
# Only needed when MARKET_DATA_PROVIDER=eodhd. https://eodhd.com
EODHD_API_TOKEN=your-eodhd-token

# --- Broker sync (SnapTrade, optional) ---
# Free developer account at https://snaptrade.com. Without these, broker sync is just hidden.
# Server-only secrets — never expose to the browser.
SNAPTRADE_CLIENT_ID=your-snaptrade-client-id
SNAPTRADE_CONSUMER_KEY=your-snaptrade-consumer-key
