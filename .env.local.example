# Copy this file to .env.local and fill in your keys.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; keep secret

# --- Market data (https://eodhd.com) ---
# Without this the app still runs, but prices show as "—".
EODHD_API_TOKEN=your-eodhd-token
