# Copy this file to .env.local and fill in your keys.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; keep secret

# --- Site URL ---
# Canonical origin for metadata/OG tags, sitemap, robots, and auth redirects. Leave unset in dev
# (falls back to the Vercel production URL, then localhost); SET THIS when a custom domain is live,
# e.g. https://snowfolio.app
# NEXT_PUBLIC_SITE_URL=https://snowfolio.app

# --- Nightly sync cron (Vercel) ---
# Secret that guards /api/cron/sync (the nightly dividends/price-history/enrichment job).
# Set the SAME value in Vercel env; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# If unset, the cron endpoint refuses all requests (fails closed).
CRON_SECRET=generate-a-long-random-string

# --- Email notifications (options/dividend alerts + weekly income digest) ---
# Uses Resend (https://resend.com — free tier is plenty). Without a key, the notification crons
# run but send nothing. EMAIL_FROM must be a verified sender/domain on your Resend account.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Snowfolio <alerts@yourdomain.com>

# --- Market data ---
# Provider behind lib/marketdata. Default "yahoo" (free, US-first) — no key needed.
# Set to "eodhd" to use the paid EODHD feed (then fill EODHD_API_TOKEN below).
MARKET_DATA_PROVIDER=yahoo
# Only needed when MARKET_DATA_PROVIDER=eodhd. https://eodhd.com
EODHD_API_TOKEN=your-eodhd-token

# --- Broker sync (SnapTrade, optional) ---
# Free developer account at https://snaptrade.com. Without these, broker sync is just hidden.
# Server-only secrets — never expose to the browser.
SNAPTRADE_CLIENT_ID=your-snaptrade-client-id
SNAPTRADE_CONSUMER_KEY=your-snaptrade-consumer-key
# SnapTrade uses ONE personal API key = one real brokerage identity (yours). So broker sync must
# be limited to your own account(s) — otherwise any signed-up user who synced would pull YOUR
# accounts into their dashboard. List the owner email(s) allowed to use broker sync, comma-separated.
# If unset, broker sync is disabled for everyone (safe default).
BROKER_SYNC_OWNER_EMAILS=you@email.com
